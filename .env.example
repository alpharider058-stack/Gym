# Never expose this value with EXPO_PUBLIC_ or commit the real .env file.
OPENROUTER_API_KEY=replace-with-a-new-key
OPENROUTER_MODEL=openai/gpt-4o-mini
APP_URL=http://localhost:8081
APP_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# The proxy binds to loopback by default.
HOST=127.0.0.1
ALLOW_LAN=false
ALLOW_ALL_INTERFACES=false

# For a physical phone on a trusted Wi-Fi, set HOST to this computer's private
# IPv4 address, ALLOW_LAN=true, and this URL to the same address. Keep the
# firewall enabled and never expose the proxy with port forwarding.
EXPO_PUBLIC_AI_PROXY_URL=http://127.0.0.1:8787
